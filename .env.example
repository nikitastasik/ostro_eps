# Скопируйте в .env и при необходимости поменяйте значения: cp .env.example .env

# --- приложение ---
APP_PORT=8080
LOG_LEVEL=INFO
# Для docker compose адрес БД собирается из POSTGRES_* (см. docker-compose.yml).
# Для локального запуска без Docker по умолчанию используется SQLite: sqlite:///./ostrovok.db
DATABASE_URL=postgresql+psycopg://app:app@db:5432/ostrovok

# --- Postgres (сервис db) ---
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=ostrovok

# --- LLM (любой OpenAI-совместимый API). Необязательно: без ключа агенты работают на правилах ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=40

# --- агенты ---
# Загрузить заранее собранное знание агентов (data/seed/seed.json.gz) при первом старте
SEED_ON_START=true
# Фоновый воркер: очередь запусков агентов и периодическая актуализация
WORKER_ENABLED=true
ACTUALIZE_INTERVAL_MIN=30
# Симулятор отельера сам отвечает на новые вопросы через ~20 секунд (демо-режим)
HOTELIER_AUTOREPLY=false

# --- демо-кабинет отельера ---
HOTELIER_LOGIN=hotelier
HOTELIER_PASSWORD=hotelier123
SECRET_KEY=change-me-in-env
